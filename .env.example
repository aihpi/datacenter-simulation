# Copy to `.env` and fill in to use the Vertex backend. The mock backend needs none of this.

# Select the LLM backend: "mock" (default, offline, deterministic) or "vertex".
LLM_BACKEND=mock

# --- Vertex AI (only needed when LLM_BACKEND=vertex) ---
# GCP project that has Vertex AI enabled.
VERTEX_PROJECT=
# Region, e.g. us-central1.
VERTEX_LOCATION=us-central1
# Model id, e.g. gemini-2.5-pro.
VERTEX_MODEL=gemini-2.5-pro
# Sampling temperature (keep low for stable JSON).
VERTEX_TEMPERATURE=0.0
# Path to a service-account JSON key, or rely on Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Frontend (optional) ---
# Override where the frontend looks for the backend (build-time). Defaults to
# http://localhost:8000 if unset.
# VITE_API_BASE=http://localhost:8000
